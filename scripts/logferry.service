[Unit]
Description=Logferry
After=network.service

[Service]
Type=simple
User=logferry

EnvironmentFile=-/etc/default/logferry
ExecStart=/usr/bin/logferry -cert $LOGFERRY_CERT -key $LOGFERRY_KEY -path $LOGFERRY_PATH -upstream $LOGFERRY_UPSTREAM
Restart=always
TimeoutStartSec=10
RestartSec=120

[Install]
WantedBy=multi-user.target
